<?xml version="1.0" encoding="UTF-8"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/routes_file.xsd">
    <!-- ============================================================== -->
    <!-- ☀️ MORNING PEAK HOUR TRAFFIC (8:00 AM - 10:30 AM)               -->
    <!-- Heavy Inbound Commute: Kathgodam/Nainital & Kaladhungi -> Center -->
    <!-- Total Inbound Volume: ~2,400 veh/hr | Outbound: ~800 veh/hr     -->
    <!-- ============================================================== -->
    <vType id="two_wheeler" accel="3.2" decel="4.5" length="2.1" width="0.8" maxSpeed="13.89" minGap="0.8" color="0.2,0.85,0.4" latAlignment="arbitrary"/>
    <vType id="auto_rickshaw" accel="1.8" decel="3.5" length="3.0" width="1.3" maxSpeed="11.11" minGap="1.2" color="0.95,0.75,0.1" latAlignment="arbitrary"/>
    <vType id="car" accel="2.6" decel="4.5" length="4.5" width="1.8" maxSpeed="13.89" minGap="1.8" color="0.85,0.25,0.2"/>
    <vType id="bus" accel="1.2" decel="3.0" length="10.5" width="2.5" maxSpeed="10.0" minGap="2.5" color="0.15,0.35,0.85"/>
    <vType id="ambulance" vClass="emergency" accel="3.8" decel="5.5" length="5.5" width="2.0" maxSpeed="16.67" color="1.0,1.0,1.0" speedFactor="1.3"/>

    <!-- Routes at Mukhani Chauraha -->
    <route id="r_KW2M_E" edges="KW2M M2KE"/>
    <route id="r_KW2M_S" edges="KW2M M2CS"/>
    <route id="r_KW2M_N" edges="KW2M M2CN"/>
    <route id="r_KE2M_W" edges="KE2M M2KW"/>
    <route id="r_CN2M_S" edges="CN2M M2CS"/>
    <route id="r_CN2M_W" edges="CN2M M2KW"/>
    <route id="r_CN2M_E" edges="CN2M M2KE"/>
    <route id="r_CS2M_N" edges="CS2M M2CN"/>

    <!-- MORNING INBOUND SURGE: Kaladhungi Rd (West) -> Market/Station (East) -->
    <flow id="m_KW_bike" type="two_wheeler" route="r_KW2M_E" begin="0" end="3600" vehsPerHour="650"/>
    <flow id="m_KW_auto" type="auto_rickshaw" route="r_KW2M_E" begin="0" end="3600" vehsPerHour="320"/>
    <flow id="m_KW_car"  type="car" route="r_KW2M_E" begin="0" end="3600" vehsPerHour="280"/>
    <flow id="m_KW_bus"  type="bus" route="r_KW2M_E" begin="0" end="3600" vehsPerHour="75"/>

    <!-- MORNING INBOUND SURGE: Nainital Rd/Canal (North) -> Rampur/Bareilly (South) -->
    <flow id="m_CN_bike" type="two_wheeler" route="r_CN2M_S" begin="0" end="3600" vehsPerHour="580"/>
    <flow id="m_CN_car"  type="car" route="r_CN2M_S" begin="0" end="3600" vehsPerHour="240"/>
    <flow id="m_CN_auto" type="auto_rickshaw" route="r_CN2M_W" begin="0" end="3600" vehsPerHour="190"/>

    <!-- Counter-flow (Lower volume during morning) -->
    <flow id="m_KE_car"  type="car" route="r_KE2M_W" begin="0" end="3600" vehsPerHour="140"/>
    <flow id="m_KE_bike" type="two_wheeler" route="r_KE2M_W" begin="0" end="3600" vehsPerHour="180"/>
    <flow id="m_CS_bike" type="two_wheeler" route="r_CS2M_N" begin="0" end="3600" vehsPerHour="160"/>
    <flow id="m_CS_car"  type="car" route="r_CS2M_N" begin="0" end="3600" vehsPerHour="110"/>

    <!-- Morning Ambulance Rush to STH Hospital -->
    <vehicle id="amb_morning_01" type="ambulance" route="r_KW2M_S" depart="90" departLane="best" departSpeed="max"/>
    <vehicle id="amb_morning_02" type="ambulance" route="r_CN2M_S" depart="350" departLane="best" departSpeed="max"/>
</routes>
