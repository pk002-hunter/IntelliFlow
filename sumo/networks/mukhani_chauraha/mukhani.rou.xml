<?xml version="1.0" encoding="UTF-8"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/routes_file.xsd">

    <!-- Indian Mixed-Traffic Vehicle Types (Heterogeneous PCU & Dimensions) -->
    
    <!-- 1. Two-Wheelers (Motorcycles / Scooters) - 40% Volume, High agility -->
    <vType id="two_wheeler" vClass="motorcycle" length="2.1" width="0.8" 
           accel="3.5" decel="5.0" sigma="0.6" maxSpeed="16.67" 
           minGap="1.0" color="0.2,0.8,0.4" latAlignment="arbitrary"/>

    <!-- 2. Auto-Rickshaws & E-Rickshaws (Vikrams) - 30% Volume, Frequent stops, low acceleration -->
    <vType id="auto_rickshaw" vClass="passenger" length="3.2" width="1.4" 
           accel="1.8" decel="3.5" sigma="0.7" maxSpeed="10.0" 
           minGap="1.5" color="0.95,0.75,0.1" latAlignment="arbitrary"/>

    <!-- 3. Passenger Cars (Hatchbacks, Sedans, SUVs) - 22% Volume -->
    <vType id="car" vClass="passenger" length="4.6" width="1.8" 
           accel="2.6" decel="4.5" sigma="0.5" maxSpeed="13.89" 
           minGap="2.5" color="0.85,0.25,0.2"/>

    <!-- 4. Buses & Mini-Trucks - 8% Volume, High passenger capacity (PCU ~3.0) -->
    <vType id="bus" vClass="bus" length="11.0" width="2.5" 
           accel="1.2" decel="3.5" sigma="0.4" maxSpeed="10.0" 
           minGap="3.0" color="0.15,0.35,0.85"/>

    <!-- 5. Emergency Ambulance (Priority Corridor towards Sushila Tiwari Hospital) -->
    <vType id="ambulance" vClass="emergency" length="5.5" width="2.0" 
           accel="3.8" decel="5.5" sigma="0.2" maxSpeed="19.44" 
           minGap="1.5" color="1.0,1.0,1.0" speedFactor="1.3"/>

    <!-- Corridors & Turning Routes -->
    <!-- Kaladhungi Road (Main Arterial) -->
    <route id="r_KW2KE" edges="KW2M M2KE"/>
    <route id="r_KE2KW" edges="KE2M M2KW"/>
    <route id="r_KW2CN" edges="KW2M M2CN"/>
    <route id="r_KW2CS" edges="KW2M M2CS"/>
    <route id="r_KE2CN" edges="KE2M M2CN"/>
    <route id="r_KE2CS" edges="KE2M M2CS"/>

    <!-- Canal Road (North) & Chhoti Mukhani (South) -->
    <route id="r_CN2CS" edges="CN2M M2CS"/>
    <route id="r_CS2CN" edges="CS2M M2CN"/>
    <route id="r_CN2KE" edges="CN2M M2KE"/>
    <route id="r_CN2KW" edges="CN2M M2KW"/>
    <route id="r_CS2KE" edges="CS2M M2KE"/>
    <route id="r_CS2KW" edges="CS2M M2KW"/>

    <!-- Traffic Flows (3,600s Simulation: ~2,400 veh/hr peak flow) -->
    <!-- Kaladhungi Road Inflows (East-West Highway) -->
    <flow id="flow_KW_bike" type="two_wheeler" route="r_KW2KE" begin="0" end="3600" vehsPerHour="360"/>
    <flow id="flow_KW_auto" type="auto_rickshaw" route="r_KW2KE" begin="0" end="3600" vehsPerHour="270"/>
    <flow id="flow_KW_car"  type="car"          route="r_KW2KE" begin="0" end="3600" vehsPerHour="200"/>
    <flow id="flow_KW_bus"  type="bus"          route="r_KW2KE" begin="0" end="3600" vehsPerHour="70"/>

    <flow id="flow_KE_bike" type="two_wheeler" route="r_KE2KW" begin="0" end="3600" vehsPerHour="360"/>
    <flow id="flow_KE_auto" type="auto_rickshaw" route="r_KE2KW" begin="0" end="3600" vehsPerHour="270"/>
    <flow id="flow_KE_car"  type="car"          route="r_KE2KW" begin="0" end="3600" vehsPerHour="200"/>
    <flow id="flow_KE_bus"  type="bus"          route="r_KE2KW" begin="0" end="3600" vehsPerHour="70"/>

    <!-- Canal Road Inflows (North) -->
    <flow id="flow_CN_bike" type="two_wheeler" route="r_CN2CS" begin="0" end="3600" vehsPerHour="160"/>
    <flow id="flow_CN_auto" type="auto_rickshaw" route="r_CN2CS" begin="0" end="3600" vehsPerHour="120"/>
    <flow id="flow_CN_car"  type="car"          route="r_CN2CS" begin="0" end="3600" vehsPerHour="80"/>

    <!-- Chhoti Mukhani Inflows (South) -->
    <flow id="flow_CS_bike" type="two_wheeler" route="r_CS2CN" begin="0" end="3600" vehsPerHour="160"/>
    <flow id="flow_CS_auto" type="auto_rickshaw" route="r_CS2CN" begin="0" end="3600" vehsPerHour="120"/>
    <flow id="flow_CS_car"  type="car"          route="r_CS2CN" begin="0" end="3600" vehsPerHour="80"/>

    <!-- Turning Movements -->
    <flow id="flow_turn_KW_CN" type="car" route="r_KW2CN" begin="0" end="3600" vehsPerHour="60"/>
    <flow id="flow_turn_KE_CS" type="car" route="r_KE2CS" begin="0" end="3600" vehsPerHour="60"/>

    <!-- Emergency Ambulance Scheduled Departures (Rushing towards Hospital via Kaladhungi Rd) -->
    <vehicle id="amb_01" type="ambulance" route="r_KW2KE" depart="300" color="1,0,0"/>
    <vehicle id="amb_02" type="ambulance" route="r_KW2KE" depart="1200" color="1,0,0"/>
    <vehicle id="amb_03" type="ambulance" route="r_KW2KE" depart="2400" color="1,0,0"/>

</routes>
