    <flow id="f_Nainital_S_bike" type="two_wheeler" route="r_Nainital_S2N" begin="0" end="3600" vehsPerHour="300"/>
    <flow id="f_Nainital_S_car"  type="car"          route="r_Nainital_S2N" begin="0" end="3600" vehsPerHour="200"/>

    <flow id="f_Rampur_S_bike" type="two_wheeler" route="r_Rampur_S2N" begin="0" end="3600" vehsPerHour="250"/>
    <flow id="f_Rampur_S_auto" type="auto_rickshaw" route="r_Rampur_S2N" begin="0" end="3600" vehsPerHour="180"/>
