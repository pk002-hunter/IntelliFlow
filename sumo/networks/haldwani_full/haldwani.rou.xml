    <!-- Scheduled Ambulances directly using Hospital Emergency Gullies -->
    <vehicle id="amb_brijlal_01" type="ambulance" route="r_Amb_to_BrijLal" depart="45" departLane="best" departSpeed="max"/>
    <vehicle id="amb_krishna_01" type="ambulance" route="r_Amb_to_Krishna" depart="120" departLane="best" departSpeed="max"/>
    <vehicle id="amb_kathgodam_01" type="ambulance" route="r_Amb_to_KathgodamHosp" depart="200" departLane="best" departSpeed="max"/>
    <vehicle id="amb_sth_01" type="ambulance" route="r_Amb_West_to_STH" depart="300" departLane="best" departSpeed="max"/>
